# Copy to .env and fill in
PORT=3000
APP_BASE_URL=http://localhost:3000

# Database — same Postgres that runs TRUE HRMS (its own `truekind` database,
# created automatically on first boot / seed). DB_DIALECT can also be `mysql`.
# Running via docker-compose.yml: DB_HOST is the HRMS db CONTAINER NAME.
DB_DIALECT=postgres
DB_HOST=truehr-db
DB_PORT=5432
DB_NAME=truekind
DB_USER=truehr
DB_PASS=

# Docker network the HRMS stack runs on (check: docker network ls | grep truehr)
TRUEHR_NETWORK=truehr_default

# Origins allowed to call /api from the browser (comma-separated).
# Leave EMPTY. The site is served by this same server, so /api is same-origin
# and needs no CORS grant. Anything you put here is a cross-origin read grant
# on the public content API — only add one if some other origin truly needs it.
ALLOWED_ORIGINS=

# Session cookie `secure` flag. Leave unset and it follows APP_BASE_URL:
# off while you are on http://, on once APP_BASE_URL is https://.
# A secure cookie over plain HTTP is silently dropped by the browser, which
# looks exactly like "my password is wrong" — hence the automatic behaviour.
# COOKIE_SECURE=true

SESSION_SECRET=change-me-to-a-long-random-string

# Seed admin (npm run seed)
ADMIN_EMAIL=admin@truekindfoundation.org
ADMIN_PASSWORD=change-me
ADMIN_NAME=True Kind Admin

# PhonePe PG — leave MERCHANT_ID empty for MOCK mode (auto-success, dev/demo)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
# production: https://api.phonepe.com/apis/hermes
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
