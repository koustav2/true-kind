<%- include('partials/head') %><%- include('partials/nav') %>
<div class="wrap" style="max-width:680px">
<p class="eyebrow">Donate</p><h1>Guest donation</h1>
<p class="muted">Donating without an account — we'll take your full details for the receipt. <a href="/portal/signup">Create an account</a> to track your donations and certificates.</p>
<div class="card">
<form method="post" action="/portal/pay/donation"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="grid g2">
    <div><label>Full name *</label><input name="name" required></div>
    <div><label>Email *</label><input type="email" name="email" required></div>
    <div><label>Mobile *</label><input type="tel" name="phone" required></div>
    <div><label>City</label><input name="city"></div>
  </div>
  <label>Address</label><input name="address">
  <label>Program</label>
  <select name="category"><% categories.forEach(c => { %><option <%= c === preset.category ? 'selected' : '' %>><%= c %></option><% }) %></select>

  <label>Amount (₹) *</label>
  <%# Preset chips, so the common amounts are one tap on a phone rather than a
      typed number. The custom box stays — it is the field that actually submits,
      and the chips only write into it. %>
  <div class="amt-row">
    <% presets.forEach(a => { %>
      <button type="button" class="amt<%= String(a) === String(preset.amount) ? ' on' : '' %>" data-amt="<%= a %>">₹<%= a.toLocaleString('en-IN') %></button>
    <% }) %>
  </div>
  <input type="number" name="amount" id="amount" min="1" required
         value="<%= preset.amount || '' %>" placeholder="Or enter any amount">
  <h3 style="margin-top:26px;font-size:1rem">For tax deduction (optional)</h3>
  <div class="grid g3">
    <div><label>PAN</label><input name="pan"></div>
    <div><label>Bank name</label><input name="bankName"></div>
    <div><label>Branch</label><input name="branchName"></div>
  </div>
  <% extraFields.forEach(f => { %>
    <label><%= f.label %><%= f.required ? ' *' : '' %></label>
    <% if (f.type === 'select') { %>
      <select name="x_<%= f.name %>" <%= f.required?'required':'' %>><% f.options.forEach(o => { %><option><%= o %></option><% }) %></select>
    <% } else if (f.type === 'textarea') { %>
      <textarea name="x_<%= f.name %>" rows="3" <%= f.required?'required':'' %>></textarea>
    <% } else { %>
      <input type="<%= f.type %>" name="x_<%= f.name %>" <%= f.required?'required':'' %>>
    <% } %>
  <% }) %>
  <div style="margin-top:22px"><button class="btn btn-primary" type="submit">Continue to payment</button></div>
</form>
</div>
<p class="muted">Donations to True Kind Foundation are eligible for tax deduction where our 80G registration applies. Enter your PAN above and the receipt will carry the details.</p>
</div>
<script>
/* Amount chips write into the number field. The field is what submits, so if
   this script never runs the form is still fully usable — the chips are an
   accelerator, not the input. */
(function () {
  var box = document.getElementById('amount');
  var chips = [].slice.call(document.querySelectorAll('.amt'));
  chips.forEach(function (c) {
    c.addEventListener('click', function () {
      box.value = c.getAttribute('data-amt');
      chips.forEach(function (o) { o.classList.toggle('on', o === c); });
      box.focus();
    });
  });
  /* Typing a custom amount clears the chip selection, so the highlight never
     contradicts the value in the box. */
  box.addEventListener('input', function () {
    chips.forEach(function (o) { o.classList.toggle('on', o.getAttribute('data-amt') === box.value); });
  });
})();
</script>
</body></html>
