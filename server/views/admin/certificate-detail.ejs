<%- include('../partials/head') %><%- include('../partials/nav', {active:'certs'}) %>
<div class="wrap">
<p class="eyebrow">Certificate</p><h1><%= cert.title %></h1>
<% if (cert.description) { %><p class="muted"><%= cert.description %></p><% } %>
<div class="grid g2">
<div class="card" style="padding:0;overflow-x:auto">
<table>
<tr><th>Member</th><th>Serial</th><th>Issued</th></tr>
<% if (!cert.issued.length) { %><tr><td colspan="3" class="muted">Not issued to anyone yet.</td></tr><% } %>
<% cert.issued.forEach(i => { %>
<tr><td><%= i.user ? `${i.user.name} (${i.user.memberId || i.user.email})` : '—' %></td>
<td class="serial"><%= i.serial %></td><td><%= i.issuedAt.toDateString() %></td></tr>
<% }) %>
</table>
</div>
<div class="card">
<h3 style="margin-top:0">Printed design</h3>
<% if (saved === 'style') { %><div class="alert ok">Design saved. Certificates of this type now print in it.</div><% } %>
<p class="muted" style="margin-top:-4px">Applies to every certificate of this type, including ones already issued — the PDF is generated fresh each time it is downloaded.</p>
<form method="post" action="/portal/admin/certificates/<%= cert._id %>/style">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:10px">
    <% Object.keys(templates).forEach(function(k){ var t = templates[k]; %>
      <label style="cursor:pointer;display:flex;gap:8px;align-items:center;padding:9px 14px;
                    border:2px solid <%= template === k ? 'var(--purple)' : 'var(--rule-strong)' %>;
                    border-radius:9px;font-size:.86rem;margin:0">
        <input type="radio" name="template" value="<%= k %>" <%= template === k ? 'checked' : '' %> style="width:auto;margin:0;accent-color:var(--purple)">
        <span style="display:inline-block;width:26px;height:18px;border:2px solid <%= t.frame %>;background:<%= t.wash %>;border-radius:2px;position:relative">
          <span style="position:absolute;right:1px;bottom:1px;width:6px;height:6px;border-radius:50%;background:<%= t.accent %>"></span>
        </span>
        <%= t.label %>
      </label>
    <% }) %>
  </div>
  <button class="btn btn-ghost btn-sm" style="margin-top:14px" type="submit">Save design</button>
</form>
</div>

<div class="card">
<h3>Issue to a member</h3>
<form method="post" action="/portal/admin/certificates/<%= cert._id %>/issue"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Active member</label>
<select name="userId" required>
<% members.forEach(m => { %><option value="<%= m._id %>"><%= m.name %> — <%= m.memberId || m.email %></option><% }) %>
</select>
<div style="margin-top:18px"><button class="btn btn-purple" type="submit">Issue (generates unique serial + QR + barcode)</button></div>
</form>
</div>
</div>

<div class="card">
<h3 style="margin-top:0">Certificate file</h3>
<% if (saved) { %><div class="alert ok">File uploaded.</div><% } %>
<% if (error === 'nofile') { %><div class="alert err">No file was selected.</div><% } %>

<% if (file) { %>
  <div class="codebox">
    <% if ((file.mimetype || '').indexOf('image/') === 0) { %>
      <img src="<%= file.url %>" alt="<%= cert.title %>">
    <% } else { %>
      <span class="serial">PDF</span>
    <% } %>
    <div>
      <b><%= file.original || file.filename %></b><br>
      <span class="muted"><%= Math.max(1, Math.round((file.bytes || 0) / 1024)) %> KB · uploaded <%= file.createdAt.toDateString() %></span>
    </div>
    <div style="display:flex;gap:6px;margin-left:auto">
      <a class="btn btn-ghost btn-sm" href="<%= file.url %>" target="_blank" rel="noopener">Open</a>
      <form method="post" action="/portal/admin/certificates/<%= cert._id %>/file/delete" style="display:inline"
            onsubmit="return confirm('Remove this certificate file?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-ghost btn-sm" type="submit">Remove</button>
      </form>
    </div>
  </div>
  <p class="cms-hint">Uploading again replaces this file.</p>
<% } else { %>
  <p class="muted">No file uploaded yet. Issued certificates still generate a PDF with a serial, QR and barcode — this is for a designed template or a scanned original.</p>
<% } %>

<form method="post" action="/portal/admin/certificates/<%= cert._id %>/file?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>Upload an image or a PDF</label>
  <input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png,.webp,.gif,.avif" required>
  <p class="cms-hint">JPG, PNG, WebP, GIF, AVIF or PDF — up to 12 MB.</p>
  <button class="btn btn-purple btn-sm" style="margin-top:12px" type="submit">Upload</button>
</form>
</div>
</div></body></html>
