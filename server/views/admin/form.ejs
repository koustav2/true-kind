<%- include('../partials/head') %><%- include('../partials/nav', {active:'form'}) %>
<div class="wrap">
<p class="eyebrow">Donation form</p><h1>Extra form fields</h1>
<p class="muted">These fields appear on both the member and guest donation forms. Add Debasish's fields here — no code change needed.</p>
<% if (saved) { %><div class="alert ok">Field added.</div><% } %>
<div class="grid g2">
<div class="card" style="padding:0;overflow-x:auto">
<table>
<tr><th>Label</th><th>Name</th><th>Type</th><th>Required</th><th></th></tr>
<% if (!fields.length) { %><tr><td colspan="5" class="muted">No extra fields yet.</td></tr><% } %>
<% fields.forEach(f => { %>
<tr><td><%= f.label %></td><td class="serial"><%= f.name %></td><td><%= f.type %></td><td><%= f.required ? 'yes':'no' %></td>
<td><form method="post" action="/portal/admin/form/remove" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="name" value="<%= f.name %>"><button class="btn btn-ghost btn-sm">remove</button></form></td></tr>
<% }) %>
</table>
</div>
<div class="card">
<h3>Add a field</h3>
<form method="post" action="/portal/admin/form/add"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Label *</label><input name="label" required placeholder="Occupation">
<label>Type</label>
<select name="type"><option>text</option><option>email</option><option>tel</option><option>number</option><option>select</option><option>textarea</option></select>
<label>Options (for select — comma separated)</label><input name="options" placeholder="Student, Professional, Other">
<label style="display:flex;align-items:center;gap:8px;font-weight:400"><input type="checkbox" name="required" style="width:auto"> Required</label>
<div style="margin-top:18px"><button class="btn btn-purple" type="submit">Add field</button></div>
</form>
</div>
</div>
</div></body></html>
