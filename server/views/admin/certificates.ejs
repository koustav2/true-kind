<%- include('../partials/head') %><%- include('../partials/nav', {active:'certs'}) %>
<div class="wrap">
<p class="eyebrow">Certificates</p><h1 style="margin-bottom:6px">Certificate types</h1>
<div class="tabs">
  <a href="/portal/admin/certificates" class="on">Certificate types</a>
  <a href="/portal/admin/certificates/generate">Generate</a>
  <a href="/portal/admin/certificates/issued">Issued register</a>
  <a href="/portal/admin/visitor-certificates">Visitor certificates</a>
</div>
<p class="muted" style="max-width:78ch">A <strong>type</strong> is the title and wording that
gets printed. Issuing one attaches it to a person and mints a unique, verifiable serial —
so a type is created once and issued many times.</p>
<div class="grid g2">
<div class="card" style="padding:0;overflow-x:auto">
<table>
<tr><th>Title</th><th>Issued</th><th></th></tr>
<% if (!certs.length) { %><tr><td colspan="3" class="muted">No certificates yet.</td></tr><% } %>
<% certs.forEach(c => { %>
<tr><td><%= c.title %></td><td><%= c.issued.length %></td>
<td><a href="/portal/admin/certificates/<%= c._id %>">open →</a></td></tr>
<% }) %>
</table>
</div>
<div class="card">
<h3>Add a certificate</h3>
<form method="post" action="/portal/admin/certificates"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Title *</label><input name="title" required placeholder="Certificate of Appreciation 2026">
<label>Description</label><textarea name="description" rows="3" placeholder="For outstanding contribution to..."></textarea>
<div style="margin-top:18px"><button class="btn btn-purple" type="submit">Create</button></div>
</form>
</div>
</div>
</div></body></html>
