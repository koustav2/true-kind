<%- include('../partials/head') %><%- include('../partials/nav', {active:'content'}) %>
<div class="wrap">
<p class="eyebrow">Website</p><h1>Site content</h1>
<% if (saved) { %><div class="alert ok">Saved. The public site reads these via /api/content/&lt;key&gt;.</div><% } %>
<div class="grid g2">
<div class="card">
  <h3>About Us</h3>
  <form method="post" action="/portal/admin/content/about"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Heading</label><input name="heading" value="<%= (byKey.about||{}).heading || '' %>">
    <label>Body</label><textarea name="body" rows="6"><%= (byKey.about||{}).body || '' %></textarea>
    <button class="btn btn-purple btn-sm" style="margin-top:14px" type="submit">Save</button>
  </form>
</div>
<div class="card">
  <h3>Homepage banner</h3>
  <form method="post" action="/portal/admin/content/banner?_csrf=<%= csrfToken %>" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Headline</label><input name="headline" value="<%= (byKey.banner||{}).headline || '' %>">
    <label>Sub-text</label><input name="subtext" value="<%= (byKey.banner||{}).subtext || '' %>">
    <label>Banner image (max 4 MB)</label><input type="file" name="image" accept="image/*">
    <% if ((byKey.banner||{}).image) { %><p class="muted">Current: <%= byKey.banner.image %></p><% } %>
    <button class="btn btn-purple btn-sm" style="margin-top:14px" type="submit">Save</button>
  </form>
</div>
<div class="card">
  <h3>Our Team (add / edit)</h3>
  <form method="post" action="/portal/admin/content/team?_csrf=<%= csrfToken %>" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Members (one per line: Name | Role | short bio)</label>
    <textarea name="rows" rows="6" placeholder="Asha Mohanty | Chairperson | Sets strategy..."><%= (byKey.team||{}).rows || '' %></textarea>
    <label>Photo (optional)</label><input type="file" name="image" accept="image/*">
    <button class="btn btn-purple btn-sm" style="margin-top:14px" type="submit">Save</button>
  </form>
</div>
<div class="card">
  <h3>Our Works</h3>
  <form method="post" action="/portal/admin/content/works"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Entries (one per line: Title | description)</label>
    <textarea name="rows" rows="6"><%= (byKey.works||{}).rows || '' %></textarea>
    <button class="btn btn-purple btn-sm" style="margin-top:14px" type="submit">Save</button>
  </form>
</div>
<div class="card">
  <h3>Press releases</h3>
  <form method="post" action="/portal/admin/content/press"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Entries (one per line: Date | Outlet | Headline | Link)</label>
    <textarea name="rows" rows="6"><%= (byKey.press||{}).rows || '' %></textarea>
    <button class="btn btn-purple btn-sm" style="margin-top:14px" type="submit">Save</button>
  </form>
</div>
</div>
</div></body></html>
