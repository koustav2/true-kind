<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="auth-wrap"><div class="card">
<p class="eyebrow">Member & admin portal</p><h2>Create your account</h2>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>
<form method="post" action="/portal/signup">
<label>Full name</label><input name="name" required>
<label>Email</label><input type="email" name="email" required>
<label>Mobile number</label><input type="tel" name="phone" required>
<label>Password (6+ characters)</label><input type="password" name="password" minlength="6" required>
<div style="margin-top:20px"><button class="btn btn-primary" type="submit" style="width:100%">Sign up</button></div>
</form>
<p class="muted" style="margin-top:16px">Already registered? <a href="/portal/signin">Sign in</a></p>
</div></div></body></html>
