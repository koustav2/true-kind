<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> | True Kind Foundation</title>
<link rel="icon" type="image/png" href="/assets/img/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* The browser's own [hidden] rule and an author class rule can tie on
   specificity (an attribute selector and a class selector are both 0-1-0);
   when they tie, whichever comes later in the cascade wins, which is always
   this stylesheet, not the UA one. `.pill{display:inline-block}` below was
   exactly that case — a <span hidden class="pill ok"> used as a toggleable
   "Saved" flash (Photographs tab) rendered visible on every field on page
   load, because .pill's display won the tie. This one line keeps hidden
   authoritative no matter what else declares display on the same element. */
[hidden]{display:none!important}

/* Kept in step with assets/css/style.css by hand — the portal does not load the
   public stylesheet, so the same token names are declared twice. If you change a
   colour there, change it here too or the admin drifts off-brand. */
:root{
  --brand-green:#59B306; --brand-blue:#0392D4; --brand-purple:#7D4AB1; --brand-red:#DF3548;
  --green:#3F7F04; --blue:#0276AC; --purple:#7D4AB1; --red:#C92135;
  --clay:#CE2438; --clay-deep:#A81B2B; --purple-deep:#5B3480; --blue-deep:#015A85;
  --green-deep:#2F5D03;
  --ink:#111827; --ink-2:#1F2937; --paper:#FFFFFF; --paper-2:#F5F7FA; --paper-3:#EAEEF3;
  --text:#1F2937; --text-soft:#4B5563; --text-mute:#5B6472;
  --rule:rgba(17,24,39,.11); --rule-strong:rgba(17,24,39,.20);
  --border-flat:#E5E7EB;
  --radius:14px; --radius-sm:9px;
}
*{box-sizing:border-box} body{margin:0;background:var(--paper-2);color:var(--text);font:400 15px/1.65 'Work Sans',system-ui,sans-serif}
h1,h2,h3{font-family:'Fraunces',Georgia,serif;color:var(--ink);font-weight:500;letter-spacing:-.02em;margin:0 0 .5em;text-wrap:balance}
a{color:inherit}
/* ---------- navigation ----------------------------------------------------
   Two rows: sections in .topnav, the current section's pages in .subnav.

   The WRAPPER is what sticks, not the two rows individually. Sticking them
   separately would mean giving .subnav a `top` equal to .topnav's height — a
   hardcoded pixel value that is wrong the moment the section list wraps to two
   lines on a narrow window, and the strip then slides underneath the bar. One
   sticky parent has no number in it to get wrong. */
.navwrap{position:sticky;top:0;z-index:20}
.topnav{display:flex;align-items:center;gap:20px;padding:11px 24px;
  border-bottom:1px solid var(--rule);background:var(--paper)}
.topnav .brand{flex:none;display:flex;align-items:center}
.topnav img{height:34px}
.topnav .secs{flex:1 1 auto;display:flex;gap:2px;flex-wrap:wrap;list-style:none;margin:0;padding:0}
.topnav .secs a{display:block;padding:8px 14px;border-radius:100px;font-size:.87rem;
  font-weight:500;text-decoration:none;color:var(--text-soft);white-space:nowrap}
.topnav .secs a:hover{background:var(--paper-3);color:var(--ink)}
/* The current section is the only filled thing in the bar. When nine links all
   had a hover-coloured tint there was no "you are here" — just nine equals. */
.topnav .secs a.on,.topnav .secs a.on:hover{background:var(--purple);color:#fff}
.navend{flex:none;display:flex;align-items:center;gap:10px}

/* Alert badge — "somebody has to do something". Deliberately rare: only unpaid
   registrations, new volunteers and new enquiries earn one. Sized to sit on the
   baseline of the label without changing the link's height, so a badge
   appearing never reflows the bar.

   SCOPED TO THE TWO NAV ROWS, and it has to be. Written as a bare `.n` this
   turned every other count in the admin into a red alert pill — the field
   counts beside each page in the CMS sidebar, the field counts on each group
   heading — because `.n` is the class those already used for a plain muted
   number. Nine red pills in the navigation was the thing being fixed; putting
   thirty of them in the CMS instead is not an improvement. */
:where(.topnav .secs, .subnav-in) a .n{
  display:inline-block;min-width:17px;padding:1px 5px;margin-left:5px;
  border-radius:100px;background:var(--clay);color:#fff;
  font:500 .64rem/1.5 'Work Sans',sans-serif;text-align:center;vertical-align:1px}
/* On the filled pill the badge inverts: solid white, purple figure. A
   translucent-white backing was the obvious move and it measured 3.49:1 for
   white text at .64rem — under the 4.5 that 10px type owes. Inverting gets
   6.02:1 and reads more sharply besides. */
.topnav .secs a.on .n{background:#fff;color:var(--purple)}
/* Totals. Not an alert, so not a colour — just a count, in the muted weight of
   a caption. 4.7:1 on the strip's background. */
.t{display:inline-block;margin-left:6px;color:var(--text-mute);
  font:400 .74rem/1 'IBM Plex Mono',monospace;vertical-align:1px}

.subnav{background:var(--paper-2);border-bottom:1px solid var(--rule)}
/* The brand rule is the bottom edge of the header, wherever the header ends —
   under the strip when there is one, under the bar when there is not. Two
   rainbow lines would read as two separate headers. */
.navwrap>:last-child{position:relative}
.navwrap>:last-child::after{content:"";position:absolute;left:0;right:0;bottom:-3px;height:3px;
  background:linear-gradient(90deg,var(--brand-blue),var(--brand-purple) 33%,var(--brand-green) 66%,var(--brand-red))}
/* Same 24px gutter as .topnav, so the strip's first item lines up with the logo
   above it rather than floating off to one side. */
.subnav-in{padding:0 24px;display:flex;align-items:center;
  gap:4px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.subnav-in::-webkit-scrollbar{display:none}
.subnav-in a{flex:none;white-space:nowrap;padding:11px 13px;font-size:.84rem;
  text-decoration:none;color:var(--text-soft);border-bottom:2px solid transparent;
  margin-bottom:-1px}
.subnav-in a:hover{color:var(--ink)}
/* An underline, not a pill. The bar above uses filled pills for sections, so
   reusing them here would make a page look like a section. Different level,
   different mark. */
.subnav-in a.on{color:var(--purple);border-bottom-color:var(--purple);font-weight:500}
/* --blue on this tint is 4.36:1 at .7rem — the same near-miss that .pill.info
   had, and fixed the same way: one step deeper for 5.17:1. The tint is
   unchanged, so nothing moves except the text getting slightly darker. */
/* The portal does not load the public stylesheet, so this is declared here too
   (same reason as the colour tokens at the top of this file). */
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;
  overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.nav-role{
  padding:4px 11px;border-radius:100px;
  background:rgba(3,146,212,.12);color:#026A9B;
  font:500 .7rem 'Work Sans',sans-serif;white-space:nowrap}
:where(.topnav,.subnav) a:focus-visible,.topnav button:focus-visible{
  outline:2px solid var(--purple);outline-offset:2px}
.wrap{max-width:1060px;margin:0 auto;padding:34px 24px 80px}
.card{background:var(--paper);border:1px solid var(--rule);border-radius:var(--radius);padding:26px;margin-bottom:20px;overflow-x:auto}
.grid{display:grid;gap:18px}
@media(min-width:760px){.g2{grid-template-columns:1fr 1fr}.g3{grid-template-columns:repeat(3,1fr)}.g4{grid-template-columns:repeat(4,1fr)}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 22px;border-radius:100px;font:500 .9rem 'Work Sans',sans-serif;text-decoration:none;border:1px solid transparent;cursor:pointer}
.btn-primary{background:var(--clay);color:#fff}.btn-primary:hover{background:var(--clay-deep)}
.btn-purple{background:var(--purple);color:#fff}.btn-purple:hover{background:var(--purple-deep)}
.btn-ghost{background:none;border-color:var(--rule-strong);color:var(--ink)}.btn-ghost:hover{border-color:var(--purple);color:var(--purple)}
.btn-sm{padding:8px 15px;font-size:.82rem}
label{display:block;font-size:.82rem;font-weight:500;color:var(--ink);margin:14px 0 6px}
input,select,textarea{width:100%;padding:12px 14px;border:1px solid var(--rule-strong);border-radius:var(--radius-sm);background:var(--paper);font:inherit;color:var(--text)}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--purple);box-shadow:0 0 0 3px rgba(125,74,177,.14)}
table{width:100%;border-collapse:collapse;font-size:.88rem}
th{font-family:'IBM Plex Mono',monospace;font-size:.64rem;letter-spacing:.14em;text-transform:uppercase;color:var(--text-soft);text-align:left;padding:10px 12px;border-bottom:1px solid var(--rule-strong)}
td{padding:12px;border-bottom:1px solid var(--rule);vertical-align:top}
.eyebrow{font-family:'IBM Plex Mono',monospace;font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--purple);margin:0 0 8px}
.pill{display:inline-block;padding:3px 11px;border-radius:100px;font-size:.72rem;font-weight:500}
/* Pill text is .72rem — 11.5px, ordinary text, so it owes 4.5:1.
   --green on its own tint came to 4.34:1 and --blue to 4.36:1: close enough to
   look fine and not close enough to pass, on the status labels that appear on
   every screen in the admin. Darkened one step each (5.0:1 and 5.2:1). The tint
   is unchanged, so nothing moves visually except the text getting slightly
   deeper. */
.pill.ok{background:rgba(89,179,6,.14);color:#3A7404}
.pill.warn{background:rgba(223,53,72,.12);color:#BD1E30}
.pill.info{background:rgba(3,146,212,.12);color:#026A9B}
.alert{padding:13px 17px;border-radius:var(--radius-sm);border:1px solid;font-size:.88rem;margin:0 0 16px}
.alert.err{background:rgba(223,53,72,.07);border-color:rgba(223,53,72,.3);color:var(--clay-deep)}
.alert.ok{background:rgba(89,179,6,.08);border-color:rgba(89,179,6,.3);color:var(--green)}
.stat b{display:block;font:500 2rem 'Fraunces',serif;color:var(--ink)}
.stat span{font-size:.8rem;color:var(--text-soft)}
/* ---------- filters, actions, segmented controls --------------------------
   These three replace a single `.tabs` class that had come to mean all of them
   plus the site navigation. Four different jobs wearing one uniform: a status
   filter that narrows a list in place looked exactly like a link to another
   page, which looked exactly like a CSV download, which looked exactly like the
   video-source radio buttons on the CMS page. They are told apart by shape now,
   and page navigation has moved out of the page body entirely and into the
   section strip in the header. */

/* FILTERS — narrow the list you are already looking at. Square-ish and quiet,
   so they never read as somewhere to go. */
.filters{display:flex;align-items:center;gap:6px;margin-bottom:18px;
  overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.filters::-webkit-scrollbar{display:none}
.filters-lbl{flex:none;margin-right:4px;font-family:'IBM Plex Mono',monospace;
  font-size:.62rem;letter-spacing:.15em;text-transform:uppercase;color:var(--text-mute)}
.filters a{flex:none;white-space:nowrap;padding:6px 12px;border-radius:var(--radius-sm);
  border:1px solid var(--border-flat);background:var(--paper);
  font-size:.82rem;text-decoration:none;color:var(--text-soft)}
.filters a:hover{border-color:var(--rule-strong);color:var(--ink)}
.filters a.on{background:var(--ink);border-color:var(--ink);color:#fff}
/* A download is an action, not a filter — pushed to the end and marked with an
   arrow so it is not mistaken for another way to slice the list. */
.filters a.dl{margin-left:auto;border-style:dashed;color:var(--text-mute)}
.filters a.dl::before{content:"\2193\00a0"}
.filters a.dl:hover{border-style:solid;border-color:var(--purple);color:var(--purple)}

/* ACTIONS — a row of things to do, not places to go. */
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.actions a{padding:6px 12px;border-radius:var(--radius-sm);border:1px dashed var(--border-flat);
  font-size:.82rem;text-decoration:none;color:var(--text-mute)}
.actions a:hover{border-style:solid;border-color:var(--purple);color:var(--purple)}

/* SEGMENTED — pick exactly one; a radio group that happens to look like a
   switch. Joined into one block so it reads as a single control with one
   selection, which is what it is. */
.segmented{display:inline-flex;border:1px solid var(--border-flat);
  border-radius:var(--radius-sm);overflow:hidden}
.segmented a{padding:7px 14px;font-size:.82rem;text-decoration:none;color:var(--text-soft);
  border-left:1px solid var(--border-flat);background:var(--paper)}
.segmented a:first-child{border-left:0}
.segmented a:hover{background:var(--paper-3);color:var(--ink)}
.segmented a.on{background:var(--purple);color:#fff;border-left-color:var(--purple)}

.codebox{display:flex;gap:18px;align-items:center;flex-wrap:wrap;padding:16px;border:1px dashed var(--rule-strong);border-radius:var(--radius-sm);margin-top:16px}
.codebox img{max-height:90px}
.serial{font-family:'IBM Plex Mono',monospace;font-size:.85rem;color:var(--purple)}
.muted{color:var(--text-soft);font-size:.88rem}
.auth-wrap{max-width:420px;margin:60px auto;padding:0 20px}
img{max-width:100%;height:auto}

/* ---------- mobile ---------- */
@media(max-width:880px){
  .topnav{flex-wrap:wrap;gap:10px;padding:10px 16px}
  .topnav img{height:30px}
  /* Logo and Sign out share the first line; the sections become one
     horizontally-scrollable row beneath them. Wrapping nine section pills into
     four stacked rows would push the page content off a phone screen. */
  .topnav .brand{order:1}
  .navend{order:2;margin-left:auto}
  .topnav .secs{order:3;width:100%;flex-wrap:nowrap;overflow-x:auto;
    -webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:2px}
  .topnav .secs::-webkit-scrollbar{display:none}
  .topnav .secs a{flex:none}
  .subnav-in{padding:0 16px}
  .wrap{padding:22px 16px 60px}
  .card{padding:18px 16px}
  h1{font-size:1.55rem}
  h2{font-size:1.25rem}
  /* stat tiles: two-up instead of a long single column */
  .grid.g4{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .stat b{font-size:1.5rem}
  /* tables: keep natural width, scroll inside the card */
  .card table td,.card table th{white-space:nowrap}
  /* 16px inputs stop iOS zoom-on-focus */
  input,select,textarea{font-size:16px}
  .btn{padding:12px 18px}
  .codebox{gap:12px;padding:12px}
  .codebox img{max-height:64px}
  .auth-wrap{margin:24px auto}
}
@media(max-width:400px){
  .grid.g4{grid-template-columns:1fr}
}

/* Donation amount chips */
.amt-row{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 10px}
.amt{padding:10px 16px;border-radius:100px;border:1px solid var(--rule-strong);background:var(--paper);
  font:500 .9rem 'Work Sans',sans-serif;color:var(--text);cursor:pointer;width:auto}
.amt:hover{border-color:var(--purple);color:var(--purple)}
.amt.on{background:var(--purple);border-color:var(--purple);color:#fff}

/* ---- CMS editor ---------------------------------------------------------
   The portal stylesheet had no two-column shell, no sticky sidebar and no
   media grid, so they are added here (one shared block, every view gets them)
   rather than inlined per view. */
.cms-shell{display:grid;gap:26px;align-items:start}
@media(min-width:900px){.cms-shell{grid-template-columns:236px 1fr}}
.cms-side{position:sticky;top:18px;display:flex;flex-direction:column;gap:3px}
@media(max-width:899px){.cms-side{position:static;flex-direction:row;overflow-x:auto;padding-bottom:6px;scrollbar-width:none}.cms-side::-webkit-scrollbar{display:none}}
.cms-side a{display:flex;justify-content:space-between;gap:8px;align-items:center;
  padding:9px 13px;border-radius:9px;text-decoration:none;font-size:.87rem;color:var(--text);white-space:nowrap}
.cms-side a:hover{background:rgba(125,74,177,.07)}
.cms-side a.on{background:var(--ink);color:#fff}
.cms-side a .n{font-family:'IBM Plex Mono',monospace;font-size:.64rem;opacity:.6}
.cms-side .sep{font-family:'IBM Plex Mono',monospace;font-size:.6rem;letter-spacing:.16em;
  text-transform:uppercase;color:var(--text-soft);margin:14px 0 4px;padding-left:13px}

.cms-group{border:1px solid var(--rule);border-radius:var(--radius);background:#fff;margin-bottom:16px;overflow:hidden}
.cms-group > summary{padding:15px 20px;cursor:pointer;font-weight:500;font-size:.95rem;
  display:flex;align-items:center;gap:10px;list-style:none}
.cms-group > summary::-webkit-details-marker{display:none}
.cms-group > summary::before{content:'\25B8';color:var(--purple);font-size:.8rem;transition:transform .15s}
.cms-group[open] > summary::before{transform:rotate(90deg)}
.cms-group > summary .n{margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:.64rem;color:var(--text-soft)}
.cms-body{padding:4px 20px 20px;border-top:1px solid var(--rule)}

.cms-field{padding:14px 0;border-bottom:1px dashed var(--rule)}
.cms-field:last-child{border-bottom:none}
.cms-field label{margin-top:0}
.cms-field .meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px}
.cms-field .key{font-family:'IBM Plex Mono',monospace;font-size:.6rem;color:var(--text-soft)}
/* A photograph field. Picture first, because that is the control people are
   looking for and the one that used to live on another screen entirely; the
   alt text is a caption on a decision already made, so it follows.
   An empty slot draws a dashed frame that says so — a bare button floating in
   white space reads as a layout bug rather than as an empty picture. */
/* A standing note at the top of a section — "this list is edited elsewhere".
   Blue rather than grey: it is orientation, not a caption, and somebody who
   misses it goes looking for rows that are deliberately not here. */
/* A page that the site reaches through another one — Chairperson's Message
   sits under About Us — is indented and marked, so the sidebar shows the same
   shape the site's own breadcrumbs do. */
.cms-side a.sub{padding-left:30px;position:relative}
.cms-side a.sub::before{
  content:"";position:absolute;left:15px;top:50%;width:8px;height:1px;
  background:var(--rule-strong)}
.cms-note{
  margin:0 0 18px;padding:14px 16px;border-radius:var(--radius-sm);
  background:rgba(3,146,212,.07);border:1px solid rgba(3,146,212,.22);
  color:var(--ink-2);font-size:.86rem;line-height:1.6;
  display:flex;flex-direction:column;align-items:flex-start;gap:12px}
.cms-note p{margin:0}
.cms-photo-row{display:grid;gap:14px;align-items:start}
@media(min-width:680px){.cms-photo-row{grid-template-columns:172px 1fr}}
.cms-photo-thumb{
  aspect-ratio:4/3;border-radius:var(--radius-sm);overflow:hidden;
  border:1px dashed var(--rule-strong);background:var(--paper-2);
  display:flex;align-items:center;justify-content:center}
.cms-photo-thumb.has-file{border-style:solid;background:none}
.cms-photo-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.cms-photo-none{
  font-family:'IBM Plex Mono',monospace;font-size:.62rem;letter-spacing:.12em;
  text-transform:uppercase;color:var(--text-mute)}
.cms-photo-actions{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.cms-field textarea{min-height:84px;resize:vertical}
.cms-field textarea.code{font-family:'IBM Plex Mono',monospace;font-size:.8rem;line-height:1.55}
.cms-err{color:var(--clay-deep);font-size:.8rem;margin-top:6px}
.cms-hint{color:var(--text-soft);font-size:.78rem;margin:4px 0 0}

/* The save bar sticks to the bottom of the window, so form rows scroll UNDER
   it. Its background was rgba(255,255,255,.95) — 95% opaque — which let the row
   behind show faintly through and read as a rendering fault rather than as a
   bar sitting on top. Opaque, with a soft edge above it so it still reads as
   floating, and enough room below the last row that nothing is ever stuck
   underneath it. */
.cms-bar{position:sticky;bottom:0;background:var(--paper);
  border-top:1px solid var(--rule-strong);padding:14px 0;margin-top:18px;
  box-shadow:0 -10px 18px -12px rgba(17,24,39,.30);
  display:flex;gap:12px;align-items:center;flex-wrap:wrap;z-index:5}
#cmsForm{padding-bottom:8px}

/* Technical field id, off by default everywhere it appears (Pages and
   Photographs both use this). It exists for the rare case someone is
   describing a problem to a developer — not for everyday editing, so it stays
   out of the way until asked for rather than sitting next to every single
   label as a permanent reminder that this is a database. */
.cms-ids-off .key{display:none}
.cms-idstoggle{display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  font-size:.85rem;color:var(--text);margin:0 0 18px;cursor:pointer}
.cms-idstoggle input{margin:0}

/* ---- Photographs tab ------------------------------------------------------
   Deliberately not built from .cms-group/<details>: 32 fields across the whole
   site does not need an accordion per page, and a page you can just scroll is
   one fewer click than a page you have to open first. */
.cms-imgpage{margin-bottom:8px}
.cms-imgpage-head{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;
  padding-top:22px;margin-bottom:2px;border-top:1px solid var(--rule)}
.cms-imgpage:first-of-type .cms-imgpage-head{border-top:none;padding-top:0}
.cms-imgpage-head h2{margin:0;font-size:1.15rem}
/* .textlink elsewhere is only ever an <a> and rides on the default underline;
   a <button> needs that spelled out since browsers do not underline those. */
.cms-field .meta button.textlink{
  background:none;border:0;padding:0;font:inherit;color:inherit;
  text-decoration:underline;text-underline-offset:2px;cursor:pointer}

.media-grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}
.media-tile{border:1px solid var(--rule);border-radius:9px;overflow:hidden;background:#fff;display:flex;flex-direction:column}
.media-tile .thumb{aspect-ratio:4/3;background:var(--paper-2);display:flex;align-items:center;justify-content:center;overflow:hidden}
.media-tile .thumb img{width:100%;height:100%;object-fit:cover}
.media-tile .thumb .vid{font-family:'IBM Plex Mono',monospace;font-size:.62rem;color:var(--text-soft)}
.media-tile .cap{padding:8px 10px;font-size:.72rem;color:var(--text-soft);word-break:break-all;flex:1}
.media-act{padding:8px 10px;border-top:1px solid var(--rule);display:flex;gap:6px}
.media-preview{display:flex;gap:12px;align-items:center;margin-top:8px;flex-wrap:wrap}
.media-preview img{width:96px;height:72px;object-fit:cover;border-radius:6px;border:1px solid var(--rule)}
</style>
</head>
<body>
