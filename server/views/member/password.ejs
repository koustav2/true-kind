<%- include('../partials/head') %><%- include('../partials/nav') %>
<div class="auth-wrap">
<p class="eyebrow">Account</p><h1>Change password</h1>

<% if (forced) { %>
  <div class="alert err">
    Your password was issued by an administrator. Please set your own before
    continuing — nothing else is available until you do.
  </div>
<% } %>
<% if (saved) { %><div class="alert ok">Password changed. <a href="/portal">Continue</a>.</div><% } %>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>

<div class="card">
<form method="post" action="/portal/member/password">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>Current password</label>
  <input type="password" name="current" autocomplete="current-password" required>
  <label>New password</label>
  <input type="password" name="next" autocomplete="new-password" minlength="8" required>
  <p class="muted">At least 8 characters.</p>
  <button class="btn btn-purple" style="margin-top:14px" type="submit">Change password</button>
</form>
</div>
</div></body></html>
